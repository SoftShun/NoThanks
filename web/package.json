{
  "name": "nothanks-remake-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "shots": "node scripts/screenshots.mjs",
    "measure": "node scripts/measure.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@fontsource/dm-serif-display": "5.2.6",
    "@pixi/react": "8.0.5",
    "gsap": "3.13.0",
    "howler": "2.2.4",
    "jsfxr": "1.4.1",
    "pixi.js": "8.13.2",
    "pretendard": "1.3.9",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "zustand": "5.0.8"
  },
  "devDependencies": {
    "@types/howler": "2.2.12",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.3",
    "playwright": "^1.63.0",
    "typescript": "5.9.2",
    "vite": "7.1.7",
    "vitest": "3.2.4"
  }
}
